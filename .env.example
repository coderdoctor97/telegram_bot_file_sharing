# ============================================================
#  Telegram-Vault File Sharing — ENVIRONMENT VARIABLES
#  Copy this file to .env (DO NOT COMMIT .env TO GIT)
#  Fill in real values before deploying.
# ============================================================

# ------------------------------------------------------------------
# REQUIRED — Bot identity (from @BotFather on Telegram)
# ------------------------------------------------------------------
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ------------------------------------------------------------------
# REQUIRED — Private channel where source files are stored
#   Format: -100<channel_id>  (must include the leading -100)
#   Get it: add @RawDataBot to your channel → it replies with the ID
# ------------------------------------------------------------------
CHANNEL_ID=-1001234567890

# ------------------------------------------------------------------
# OPTIONAL — Override bot username (normally read from bot.py code)
#   Leave as-is unless your bot username differs from what is hard-coded
# ------------------------------------------------------------------
BOT_USERNAME=CHANGE_ME_bot

# ------------------------------------------------------------------
# OPTIONAL — Hosting port (only needed for Render webhook mode)
#   PythonAnywhere ignores this; Render uses the $PORT env var directly.
# ------------------------------------------------------------------
PORT=10000
